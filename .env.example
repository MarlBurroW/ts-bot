# TeamSpeak 3 Connection
TS3_SERVER=ts3.example.com:9987
TS3_NICKNAME=OpenClaw Bot
TS3_PASSWORD=
TS3_CHANNEL=

# WebSocket API
WS_HOST=127.0.0.1
WS_PORT=8080

# Logging
LOG_LEVEL=INFO
LOG_FILE=

# Reconnection (optional, uses defaults if not set)
RECONNECT_MAX_ATTEMPTS=10
RECONNECT_INITIAL_DELAY_MS=1000
RECONNECT_MAX_DELAY_MS=60000

# TTS (Text-to-Speech) via OpenAI-compatible HTTP API
# Works with: OpenAI, kokorox, Fish Speech, CosyVoice, etc.
TTS_ENABLED=true
TTS_API_URL=https://api.openai.com/v1/audio/speech
TTS_API_KEY=sk-your-openai-api-key
TTS_MODEL=tts-1
TTS_VOICE=nova
